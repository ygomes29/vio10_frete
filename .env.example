# ViO10 — exemplo de variáveis de ambiente.
# NUNCA commit valores reais. Copie para .env.local (gitignored) e preencha.
# service_role e INTERNAL_API_KEY são server-side ONLY — nunca expostos ao client/n8n/IA.

# Supabase dev
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only (nunca NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth interna para system-callers (n8n) — ADR-019 D3
INTERNAL_API_KEY=generate-a-32-byte-hex-secret

# Signed links de ação do fluxo WhatsApp (driver responde oferta sem login) — ADR-020 D3
# Fail-closed se ausente (handler recusa gerar/verificar). 32+ bytes aleatórios.
ACTION_LINK_SIGNING_SECRET=generate-a-32-byte-hex-secret

# Webhook signature inbound DataCrazy (HMAC-SHA256 do raw body) — ADR-020 D5
# Fail-closed se ausente (recusa tudo). Compartilhado só com o emissor (DataCrazy/n8n).
DATACRAZY_WEBHOOK_SECRET=generate-a-32-byte-hex-secret

# ---- WhatsApp outbound (Sessão 16 / ADR-021) — server-only, nunca NEXT_PUBLIC_ ----
# Roteamento híbrido (D1): conversa fresca → DataCrazy nativo; cold/expirado → Evolution.
# Sem nenhum configurado → /api/internal/notifications/send retorna 501
# whatsapp_provider_not_configured (não simular PASS — regra mestra).

# DataCrazy nativo (envia a conversa existente, janela 24h). Bearer (outbound ≠ inbound HMAC).
DATACRAZY_API_BASE_URL=https://crm.datacrazy.io
DATACRAZY_API_KEY=your-datacrazy-api-key

# Evolution API V2 (cold proactive — envia a qualquer número, sidesteps templates Meta).
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-evolution-apikey
EVOLUTION_INSTANCE_NAME=vio10

# Base pública da app p/ construir URLs de signed links (n8n embute na mensagem) — ADR-020 D4
NEXT_PUBLIC_APP_URL=http://localhost:3000