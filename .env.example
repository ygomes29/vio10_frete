# ViO10 — exemplo de variáveis de ambiente.
# NUNCA commit valores reais. Copie para .env.local (gitignored) e preencha.
# service_role e INTERNAL_API_KEY são server-side ONLY — nunca expostos ao client/n8n/IA.

# Supabase dev
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only (nunca NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth interna para system-callers (n8n) — ADR-019 D3
INTERNAL_API_KEY=generate-a-32-byte-hex-secret